# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). NUNCA envie o .env.local para o GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: só existe no servidor. Nunca use em código do navegador.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails de aviso (resend.com > API Keys). Sem a chave, os avisos só aparecem no log.
RESEND_API_KEY=
# Remetente com domínio verificado no Resend, ex.: Otto <avisos@seudominio.com.br>
EMAIL_REMETENTE=
